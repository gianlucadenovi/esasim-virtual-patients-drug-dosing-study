{
    "id": "ws-virtual-patients-pbpk-dosing",
    "version": "1",
    "name": "Virtual patients (PBPK dosing)",
    "category": "Life sciences",
    "icon": "activity",
    "side": "backend",
    "customizable": true,
    "summary": "A whole-body physiologically based pharmacokinetic model of a drug in thousands of virtual patients: a trial of a dosing regimen, the best dose per population, and one patient followed live in 3D",
    "help": "Run a virtual trial: a population (healthy adults, smokers, elderly, liver cirrhosis, heart failure, kidney impairment, a mixed clinical population) on a regimen; who ends up in the target range, below it, above it, and who reaches toxic peaks, overall and by group. Find the dose: for every population, the dose that puts the most patients in range while keeping toxic peaks rare. Follow one patient (3D): the typical, most exposed, least exposed or a random patient, each organ coloured by the drug's concentration there, live. Make the 3D models: the patient, the platform and the scene for the project's assets. The model is linear, so each run is a few seconds even for 10,000 patients (GPU or CPU).",
    "inputs": [],
    "outputs": [
        {
            "id": "course",
            "label": "Course",
            "type": "table",
            "formats": [
                "csv"
            ],
            "help": "course.csv: the plasma concentration over time, percentiles over the patients (p05, p25, median, p75, p95), with the target range and the toxic level"
        },
        {
            "id": "patients",
            "label": "Patients",
            "type": "table",
            "formats": [
                "csv"
            ],
            "help": "patients.csv: one row per virtual patient (who they are, clearance, half-life, trough, peak, average, outcome)"
        },
        {
            "id": "groups",
            "label": "By group",
            "type": "table",
            "formats": [
                "csv"
            ],
            "help": "groups.csv: in range, below, above and toxic peaks for each group (smokers, age bands, sex, conditions)"
        },
        {
            "id": "doses",
            "label": "Doses tried",
            "type": "table",
            "formats": [
                "csv"
            ],
            "help": "Find the dose: dose_finding.csv, every dose tried for every population"
        },
        {
            "id": "best",
            "label": "Best doses",
            "type": "table",
            "formats": [
                "csv"
            ],
            "help": "Find the dose: best_doses.csv, the dose chosen for each population"
        },
        {
            "id": "models",
            "label": "3D models",
            "type": "files",
            "formats": [
                "glb",
                "json",
                "wav"
            ],
            "help": "Make the 3D models: patient.glb, platform.glb, ring.glb, heartbeat.wav, patient.scene.json for the project's assets (models/)"
        }
    ],
    "params": [
        {
            "key": "mode",
            "label": "What to do",
            "type": "select",
            "default": "Run a virtual trial",
            "options": [
                "Run a virtual trial",
                "Find the dose",
                "Follow one patient (3D)",
                "Make the 3D models"
            ]
        },
        {
            "key": "drug",
            "label": "Drug",
            "type": "select",
            "default": "Theophylline",
            "options": [
                "Theophylline"
            ]
        },
        {
            "key": "population",
            "label": "Population",
            "type": "select",
            "default": "Healthy adults",
            "options": [
                "Healthy adults",
                "Smokers",
                "Elderly (65+)",
                "Liver cirrhosis",
                "Heart failure",
                "Kidney impairment",
                "Mixed clinical population"
            ]
        },
        {
            "key": "patients",
            "label": "Virtual patients",
            "type": "number",
            "default": 2000,
            "min": 10,
            "max": 100000
        },
        {
            "key": "female_pct",
            "label": "Women (%)",
            "type": "number",
            "default": 50,
            "min": 0,
            "max": 100
        },
        {
            "key": "route",
            "label": "Route",
            "type": "select",
            "default": "Oral (immediate release)",
            "options": [
                "Oral (immediate release)",
                "Oral (sustained release)",
                "IV infusion"
            ]
        },
        {
            "key": "dose_mg",
            "label": "Dose",
            "type": "number",
            "default": 300,
            "min": 0
        },
        {
            "key": "dose_basis",
            "label": "Dose in",
            "type": "select",
            "default": "mg",
            "options": [
                "mg",
                "mg/kg"
            ]
        },
        {
            "key": "interval_h",
            "label": "Every (h)",
            "type": "number",
            "default": 12,
            "min": 1,
            "max": 168
        },
        {
            "key": "loading_mg",
            "label": "Extra with the first dose",
            "type": "number",
            "default": 0,
            "min": 0,
            "help": "A loading dose, in the same unit as the dose"
        },
        {
            "key": "infusion_h",
            "label": "IV infusion over (h)",
            "type": "number",
            "default": 0.5,
            "min": 0.1
        },
        {
            "key": "days",
            "label": "Days",
            "type": "number",
            "default": 5,
            "min": 1,
            "max": 30
        },
        {
            "key": "target",
            "label": "Target range",
            "type": "select",
            "default": "10-20 mg/L (classic)",
            "options": [
                "10-20 mg/L (classic)",
                "5-15 mg/L (current guidance)"
            ]
        },
        {
            "key": "population_scope",
            "label": "Find the dose for",
            "type": "select",
            "default": "All populations",
            "options": [
                "All populations",
                "The population chosen"
            ]
        },
        {
            "key": "max_toxic_pct",
            "label": "Find the dose: toxic peaks at most (%)",
            "type": "number",
            "default": 5,
            "min": 0,
            "max": 100
        },
        {
            "key": "follow",
            "label": "Follow",
            "type": "select",
            "default": "The typical patient",
            "options": [
                "The typical patient",
                "The most exposed patient",
                "The least exposed patient",
                "A random patient"
            ]
        },
        {
            "key": "speed",
            "label": "Follow: simulated hours per second",
            "type": "number",
            "default": 1,
            "min": 0.05,
            "max": 48
        },
        {
            "key": "accelerator",
            "label": "Run on",
            "type": "select",
            "default": "auto",
            "options": [
                "auto",
                "NVIDIA GPU",
                "CPU"
            ]
        },
        {
            "key": "seed",
            "label": "Seed",
            "type": "number",
            "default": 1
        }
    ],
    "hardware": [
        "cpu",
        "nvidia"
    ],
    "packages": [
        "numpy",
        "torch",
        "scikit-image"
    ],
    "esasim": {
        "version": 3
    }
}
