{
    "id": "ws-virtual-patients-pbpk-dosing",
    "version": "1",
    "name": "Virtual patients (PBPK dosing)",
    "category": "Life sciences",
    "icon": "code",
    "side": "backend",
    "customizable": true,
    "summary": "A whole-body physiologically based pharmacokinetic model of three drugs in thousands of virtual patients: trials, the best dose per population, and a live bedside with vitals and a 3D patient",
    "help": "Drugs: theophylline (liver, smoking), midazolam (sedative, stored in fat) and digoxin (kidneys, heart). Run a virtual trial: a population on a regimen; who ends up in the target range, below it, above it, and who reaches toxic levels, overall and by group. Find the dose: for every population, the dose that puts the most patients in range while keeping toxic levels rare. Bedside (live): one patient at a time, chosen and dosed from the Bedside monitor view (patient, drug, dose, extra dose, stop, speed); the organs coloured by how much drug they hold, the vitals responding to the drug, a healthy adult on the same drug for comparison. Make the 3D models: the patient (from a labelled CT case, or a mockup), the platform and the scene, also streamed for the Model files view. Concentrations are in each drug's unit (mg/L for theophylline, ng/mL for the others).",
    "inputs": [
        {
            "id": "ct",
            "label": "CT case",
            "type": "files",
            "many": true,
            "optional": true,
            "formats": [
                "gz",
                "nii"
            ],
            "help": "Make the 3D models: a CT case with its labels (ct.nii.gz and segmentations/<structure>.nii.gz, as the TotalSegmentator dataset gives them). Without it, the CT case setting, else a mockup body."
        }
    ],
    "outputs": [
        {
            "id": "course",
            "label": "Course",
            "type": "table",
            "formats": [
                "csv"
            ],
            "help": "course.csv: the plasma concentration over time, percentiles over the patients (p05, p25, median, p75, p95), with the target range and the toxic level"
        },
        {
            "id": "patients",
            "label": "Patients",
            "type": "table",
            "formats": [
                "csv"
            ],
            "help": "patients.csv: one row per virtual patient (who they are, clearance, half-life, trough, peak, average, outcome)"
        },
        {
            "id": "groups",
            "label": "By group",
            "type": "table",
            "formats": [
                "csv"
            ],
            "help": "groups.csv: in range, below, above and toxic peaks for each group (smokers, age bands, sex, conditions)"
        },
        {
            "id": "doses",
            "label": "Doses tried",
            "type": "table",
            "formats": [
                "csv"
            ],
            "help": "Find the dose: dose_finding.csv, every dose tried for every population"
        },
        {
            "id": "best",
            "label": "Best doses",
            "type": "table",
            "formats": [
                "csv"
            ],
            "help": "Find the dose: best_doses.csv, the dose chosen for each population"
        },
        {
            "id": "models",
            "label": "3D models",
            "type": "files",
            "formats": [
                "glb",
                "json"
            ],
            "help": "Make the 3D models: patient.glb, platform.glb, ring.glb, patient.scene.json for the project's assets (models/)"
        }
    ],
    "params": [
        {
            "key": "mode",
            "label": "What to do",
            "type": "select",
            "default": "Run a virtual trial",
            "options": [
                "Run a virtual trial",
                "Find the dose",
                "Bedside (live)",
                "Make the 3D models"
            ]
        },
        {
            "key": "drug",
            "label": "Drug",
            "type": "select",
            "default": "Theophylline",
            "options": [
                "Theophylline",
                "Midazolam",
                "Digoxin"
            ]
        },
        {
            "key": "population",
            "label": "Population",
            "type": "select",
            "default": "Healthy adults",
            "options": [
                "Healthy adults",
                "Smokers",
                "Elderly (65+)",
                "Liver cirrhosis",
                "Heart failure",
                "Kidney impairment",
                "Mixed clinical population"
            ]
        },
        {
            "key": "patients",
            "label": "Virtual patients",
            "type": "number",
            "default": 2000,
            "min": 10,
            "max": 100000
        },
        {
            "key": "female_pct",
            "label": "Women (%)",
            "type": "number",
            "default": 50,
            "min": 0,
            "max": 100
        },
        {
            "key": "route",
            "label": "Route",
            "type": "select",
            "default": "Oral (immediate release)",
            "options": [
                "Oral (immediate release)",
                "Oral (sustained release)",
                "IV infusion"
            ]
        },
        {
            "key": "dose_mg",
            "label": "Dose",
            "type": "number",
            "default": 300,
            "min": 0,
            "help": "mg (or mg/kg): theophylline 300 mg, midazolam a few mg, digoxin 0.125-0.25 mg"
        },
        {
            "key": "dose_basis",
            "label": "Dose in",
            "type": "select",
            "default": "mg",
            "options": [
                "mg",
                "mg/kg"
            ]
        },
        {
            "key": "interval_h",
            "label": "Every (h)",
            "type": "number",
            "default": 12,
            "min": 1,
            "max": 168
        },
        {
            "key": "loading_mg",
            "label": "Extra with the first dose",
            "type": "number",
            "default": 0,
            "min": 0,
            "help": "A loading dose, in the same unit as the dose"
        },
        {
            "key": "infusion_h",
            "label": "IV infusion over (h)",
            "type": "number",
            "default": 0.5,
            "min": 0.1
        },
        {
            "key": "days",
            "label": "Days",
            "type": "number",
            "default": 5,
            "min": 1,
            "max": 30
        },
        {
            "key": "target",
            "label": "Target range (theophylline)",
            "type": "select",
            "default": "10-20 mg/L (classic)",
            "options": [
                "10-20 mg/L (classic)",
                "5-15 mg/L (current guidance)"
            ],
            "help": "Midazolam: sedation 70-260 ng/mL; digoxin: 0.5-2 ng/mL"
        },
        {
            "key": "population_scope",
            "label": "Find the dose for",
            "type": "select",
            "default": "All populations",
            "options": [
                "All populations",
                "The population chosen"
            ]
        },
        {
            "key": "max_toxic_pct",
            "label": "Find the dose: toxic levels at most (%)",
            "type": "number",
            "default": 5,
            "min": 0,
            "max": 100
        },
        {
            "key": "bedside_patient",
            "label": "Bedside: first patient",
            "type": "select",
            "default": "Elderly woman, 84",
            "options": [
                "Healthy man, 35",
                "Healthy woman, 30",
                "Smoker, 45 (20 a day)",
                "Obese woman, 40 (BMI 38)",
                "Elderly woman, 84",
                "Liver cirrhosis, 58",
                "Heart failure, 72",
                "Kidney failure, 66 (GFR 20)",
                "Random patient"
            ],
            "help": "The Bedside monitor view changes the patient and the drug while it runs"
        },
        {
            "key": "bedside_minutes",
            "label": "Bedside: minutes it stays open",
            "type": "number",
            "default": 20,
            "min": 1,
            "max": 120
        },
        {
            "key": "ct_case",
            "label": "Make the 3D models: CT case",
            "type": "text",
            "default": "",
            "help": "With nothing wired to CT case: a case of the TotalSegmentator dataset (such as s1400), read in place from Zenodo. Empty: the mockup body."
        },
        {
            "key": "accelerator",
            "label": "Run on",
            "type": "select",
            "default": "auto",
            "options": [
                "auto",
                "NVIDIA GPU",
                "CPU"
            ]
        },
        {
            "key": "seed",
            "label": "Seed",
            "type": "number",
            "default": 1
        }
    ],
    "hardware": [
        "cpu",
        "nvidia"
    ],
    "packages": [
        "numpy",
        "torch",
        "scikit-image",
        "scipy",
        "SimpleITK",
        "trimesh",
        "fast-simplification",
        "remotezip",
        "requests"
    ],
    "esasim": {
        "version": 21
    }
}
